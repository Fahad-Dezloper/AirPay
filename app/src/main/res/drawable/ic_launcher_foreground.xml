<?xml version="1.0" encoding="utf-8"?>
<!-- A duffle bag, drawn as vectors so there are no bitmap assets to keep in sync.
     108dp canvas; the art is scaled to 0.85 to stay inside the 66dp safe circle that
     Android masks adaptive icons down to. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="58"
        android:scaleX="0.85"
        android:scaleY="0.85">
        <!-- handle -->
        <path
            android:strokeColor="#14F195"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:pathData="M42,52 V46 a12,12 0 0 1 24,0 V52" />
        <!-- body -->
        <path
            android:fillColor="#14F195"
            android:pathData="M30,52 h48 a10,10 0 0 1 10,10 v10 a10,10 0 0 1 -10,10 h-48 a10,10 0 0 1 -10,-10 v-10 a10,10 0 0 1 10,-10 z" />
        <!-- the zip, cut out of the bag so it reads at small sizes -->
        <path
            android:strokeColor="#0B0D10"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M28,64 h52" />
    </group>
</vector>
