<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Android 11+ hides other apps unless we say what we are looking for. Without this the
        wallet picker sees nothing: queryIntentActivities returns an empty list, not an error,
        so it would simply look as though no wallets were installed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="solana-wallet" />
        </intent>
        <!-- The stores, so getInstallSourceInfo will name them.
             Package visibility filters the INSTALLER's name too: without being able to see
             these, Android hands back null for where a wallet came from, and null is
             indistinguishable from genuinely sideloaded. That turned a security check into a
             false accusation against a wallet installed from the dApp Store. -->
        <package android:name="com.solanamobile.dappstore" />
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Duffle"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">

        <!-- CellUp: mobile recharges only. The AirPay screens (MainActivity and the tap, scan
             and request activities) stay in the code but are no longer reachable; NFC, the
             camera and the wallet-app hooks are gone with them. -->
        <activity
            android:name=".CellUpActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TapMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
