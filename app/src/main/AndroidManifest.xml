<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <!-- Reading a payment code. Decoding is on-device; nothing is uploaded. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Reads which SIMs are in the phone, so a recharge can start from "which of these"
      rather than a blank box — and above all so the NETWORK is picked by the device
      instead of guessed, since sending a recharge to the wrong one cannot be undone.

      Optional in every sense: it is requested from the recharge screen at the moment
      somebody taps "Use my SIM", never at launch, and the screen works without it. The
      carrier name alone needs no permission; this is what adds the second SIM and,
      where the SIM carries one, the number.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- NFC is required to pay; HCE only to be paid. Not required, so the app still
         installs on a phone that can only read. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

    <!--
        Android 11+ hides other apps unless we say what we are looking for. Without this the
        wallet picker sees nothing: queryIntentActivities returns an empty list, not an error,
        so it would simply look as though no wallets were installed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="solana-wallet" />
        </intent>
        <!-- The stores, so getInstallSourceInfo will name them.
             Package visibility filters the INSTALLER's name too: without being able to see
             these, Android hands back null for where a wallet came from, and null is
             indistinguishable from genuinely sideloaded. That turned a security check into a
             false accusation against a wallet installed from the dApp Store. -->
        <package android:name="com.solanamobile.dappstore" />
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Duffle"
        android:allowBackup="false">

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The popup that appears when phones touch. Exported because Android's NFC stack
             launches it after reading the other phone's NDEF tag; everything it receives is
             validated like radio input, and paying still needs the wallet's own approval.
             Its own task, so it slides over whatever app is open instead of pulling up Tap. -->
        <activity
            android:name=".TapPopupActivity"
            android:exported="true"
            android:theme="@style/Theme.Duffle.Popup"
            android:taskAffinity="so.duffle.app.popup"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.so.duffle.app" />
            </intent-filter>
        </activity>

        <service
            android:name=".TapHostApduService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>

        <service
            android:name=".TapMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
