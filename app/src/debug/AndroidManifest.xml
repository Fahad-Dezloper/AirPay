<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets a phone reach a development server on the LAN over plain HTTP.
     Release builds keep Android's default, which requires HTTPS. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true">
        <!-- The haptic feel test. Exported so adb can open it, and declared here rather than
             in main so it cannot exist in a release build. -->
        <activity
            android:name=".HapticLabActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
        <!-- The phones-touch glow and ripple, played without two phones. Same reasons. -->
        <activity
            android:name=".TapEffectLabActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
    </application>
</manifest>
